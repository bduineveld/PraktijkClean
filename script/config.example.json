{
  "schemaVersion": 1,
  "simulationMode": true,
  "automaticCleanupConfirmed": false,
  "paused": false,
  "maxFilesPerRun": 200,
  "minimumAgeMinutes": 15,
  "deleteMode": "recycleBin",
  "emptyRecycleBin": true,
  "recycleBinRetentionDays": 1,
  "schedule": {
    "daily": true,
    "dailyTime": "12:30",
    "atLogon": true
  },
  "folders": [
    {
      "id": "desktop",
      "displayName": "Bureaublad",
      "enabled": true,
      "type": "knownFolder",
      "knownFolder": "Desktop",
      "path": null,
      "expectedPath": "C:\\Users\\voorbeeld\\Desktop",
      "retentionDays": 1,
      "recurse": false,
      "allowNetworkOrSync": false,
      "exclusions": {
        "files": [],
        "subfolders": [],
        "patterns": [],
        "extensions": [".lnk", ".url"]
      }
    },
    {
      "id": "downloads",
      "displayName": "Downloads",
      "enabled": true,
      "type": "knownFolder",
      "knownFolder": "Downloads",
      "path": null,
      "expectedPath": "C:\\Users\\voorbeeld\\Downloads",
      "retentionDays": 1,
      "recurse": false,
      "allowNetworkOrSync": false,
      "exclusions": {
        "files": [],
        "subfolders": [],
        "patterns": [],
        "extensions": [".lnk", ".url"]
      }
    }
  ]
}
